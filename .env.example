# LLM-as-judge・（既定バックエンドでは）生成と埋め込みにも使う。
# **LLM_BACKEND / EMBEDDING_BACKEND を local にしても judge は OpenAI 固定**なので、常に必要
OPENAI_API_KEY=sk-...

# --- 生成・エージェント -------------------------------------------------
# バックエンド: openai（既定）| local
# local にすると docker/compose.yaml で立てた llama.cpp サーバ（port 8080）へ向く
# LLM_BACKEND=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=qwen3.8-27b
# llama.cpp は認証しないが、OpenAI互換クライアントが未設定を嫌うので置いている
# LOCAL_LLM_API_KEY=not-needed

# --- 埋め込み -----------------------------------------------------------
# バックエンド: openai（既定）| local
# **LLM_BACKEND とは独立の軸。** 実験軸は1本ずつ動かすこと（両方同時に local にすると
# どちらの寄与か分離できない）。local にすると docker/compose.yaml の llama-embed-*
# （CPU実行 / port 8081）へ向く。
# **埋め込みを変えたらインデックスを作り直すこと**（data/index-<slug>/ に別々に作られる）
# EMBEDDING_BACKEND=local
# LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
# ruri-v3-310m（既定 / 768次元 / mean / prefix必須）| bge-m3（1024次元 / cls / prefix不要）
# LOCAL_EMBEDDING_MODEL=ruri-v3-310m
# LOCAL_EMBEDDING_API_KEY=not-needed

# --- 評価 ---------------------------------------------------------------
# 比較実験の同時実行数。既定は openai=2 / local=1。
# ローカルは単一GPUを奪い合うだけなので増やしても得はない
# EVAL_CONCURRENCY=1

# --- インデックス -------------------------------------------------------
# LanceDB の日本語BM25トークナイザ: icu（既定）| lindera/ipadic | ngram | simple
# simple は日本語をほぼ分割できず BM25 が壊れる（docs/decisions/0007 参照）
# FTS_TOKENIZER=icu

# lindera トークナイザを使う場合のみ設定（icu / ngram なら不要）
# LANCE_LANGUAGE_MODEL_HOME=./data/language_models

# --- データ取得 ---------------------------------------------------------
# Qiita API。未設定でも動くが 60req/h 制限。設定すると 1000req/h
# https://qiita.com/settings/applications で発行（read_qiita スコープのみで足りる）
QIITA_TOKEN=
QIITA_USERNAME=your-qiita-id
