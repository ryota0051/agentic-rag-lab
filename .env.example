# LLM（生成・エージェント・LLM-as-judge）と埋め込みの両方に使う
OPENAI_API_KEY=sk-...

# Qiita API。未設定でも動くが 60req/h 制限。設定すると 1000req/h
# https://qiita.com/settings/applications で発行（read_qiita スコープのみで足りる）
QIITA_TOKEN=
QIITA_USERNAME=your-qiita-id

# lindera トークナイザを使う場合のみ設定（icu / ngram なら不要）
# LANCE_LANGUAGE_MODEL_HOME=./data/language_models
