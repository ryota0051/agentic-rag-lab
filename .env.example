# 埋め込み・LLM-as-judge・（既定バックエンドでは）生成にも使う。
# LLM_BACKEND=local にしても**埋め込みと judge は OpenAI のまま**なので、常に必要
OPENAI_API_KEY=sk-...

# 生成・エージェントを回すバックエンド: openai（既定）| local
# local にすると docker/compose.yaml で立てた llama.cpp サーバへ向く。
# 埋め込みモデルとLanceDBインデックスは切り替えの影響を受けない（検索側は固定）
# LLM_BACKEND=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=qwen3.8-27b

# 比較実験の同時実行数。既定は openai=2 / local=1。
# ローカルは単一GPUを奪い合うだけなので増やしても得はない
# EVAL_CONCURRENCY=1

# Qiita API。未設定でも動くが 60req/h 制限。設定すると 1000req/h
# https://qiita.com/settings/applications で発行（read_qiita スコープのみで足りる）
QIITA_TOKEN=
QIITA_USERNAME=your-qiita-id

# lindera トークナイザを使う場合のみ設定（icu / ngram なら不要）
# LANCE_LANGUAGE_MODEL_HOME=./data/language_models
