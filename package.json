{
  "name": "agentic-rag-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ナイーブRAG / ハイブリッド検索 / エージェント的RAG の3パターン比較実験",
  "scripts": {
    "ingest": "tsx src/index/ingest-qiita.ts",
    "build-index": "tsx src/index/build-index.ts",
    "verify-fts": "tsx src/index/verify-fts.ts",
    "exp:naive": "tsx scripts/run-workflow.ts naive",
    "exp:hybrid": "tsx scripts/run-workflow.ts hybrid",
    "exp:agentic": "tsx scripts/run-workflow.ts agentic",
    "gen:golden": "tsx evals/generate-golden-set.ts",
    "gen:multihop": "tsx evals/generate-multihop-set.ts",
    "probe:retrieval": "tsx evals/probe-retrieval.ts",
    "validate:golden": "tsx evals/validate-golden-set.ts",
    "serve:local": "docker compose -f docker/compose.yaml up -d",
    "serve:local:down": "docker compose -f docker/compose.yaml down",
    "serve:local:logs": "docker compose -f docker/compose.yaml logs -f",
    "verify-local-llm": "tsx evals/verify-local-llm.ts",
    "eval": "tsx evals/run-comparison.ts",
    "eval:skill": "tsx evals/run-skill-eval.ts",
    "smoke": "tsx evals/smoke-agentic.ts",
    "diagnose": "tsx evals/diagnose-agentic.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.33.0",
    "@mastra/core": "^1.57.0",
    "@mastra/evals": "^1.7.0",
    "@mastra/libsql": "^1.19.0",
    "dotenv": "^17.2.3",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
